# Application
NODE_ENV=development
API_PORT=4000
WEB_APP_URL=http://localhost:3000

# Database
POSTGRES_USER=ancastle
POSTGRES_PASSWORD=ancastle_dev
POSTGRES_DB=ancastle_farms
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ancastle:ancastle_dev@localhost:5432/ancastle_farms?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication
# Replace these values with cryptographically secure secrets.
JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Logging
LOG_LEVEL=info