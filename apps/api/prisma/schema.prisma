// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum InventoryUnit {
  EACH
  KG
  G
  L
  ML
}

enum InventoryCategory {
  FEED
  VITAMIN
  PRODUCE
  SUPPLY
  OTHER
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms                   Farm[]
  organizationMemberships OrganizationMembership[]
  customers               Customer[]
  suppliers               Supplier[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  flocks                  Flock[]

  @@map("organizations")
}

model Farm {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  accessAssignments  FarmAccessAssignment[]
  inventoryMovements InventoryMovement[]
  flocks             Flock[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("farms")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        OrganizationMembership[]
  authSessions       AuthSession[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model OrganizationMembership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  displayName    String?
  role           MembershipRole @default(STAFF)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  farmAccessAssignments FarmAccessAssignment[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, isActive])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model FarmAccessAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  membershipId   String   @db.Uuid
  farmId         String   @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  membership OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  farm       Farm                   @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([membershipId, farmId])
  @@index([organizationId, membershipId, isActive])
  @@index([organizationId, farmId])
  @@map("farm_access_assignments")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  code           String
  type           CustomerType

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, type])
  @@map("customers")
}

model Supplier {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  code           String

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("suppliers")
}

model InventoryItem {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  code              String
  name              String
  description       String?
  unit              InventoryUnit
  category          InventoryCategory
  lowStockThreshold Decimal?          @db.Decimal(18, 3)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  inventoryMovements InventoryMovement[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, category])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @db.Uuid
  farmId          String                  @db.Uuid
  inventoryItemId String                  @db.Uuid
  actorUserId     String                  @db.Uuid
  quantity        Decimal                 @db.Decimal(18, 3)
  reason          InventoryMovementReason
  occurredAt      DateTime
  note            String?
  reference       String?
  createdAt       DateTime                @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  farm          Farm          @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  inventoryItem InventoryItem @relation(fields: [organizationId, inventoryItemId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  actorUser     User          @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, farmId, inventoryItemId, occurredAt])
  @@index([organizationId, inventoryItemId])
  @@index([actorUserId])
  @@index([organizationId, occurredAt])
  @@map("inventory_movements")
}

enum InventoryMovementReason {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

// A biological placement batch; live population is derived from mortality history.
model Flock {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  farmId               String    @db.Uuid
  // Allocated server-side by the creation workflow, like M2/M3 master-data codes.
  code                 String
  name                 String
  birdType             String?
  placementDate        DateTime  @db.Date
  startingBirdCount    Int
  expectedMaturityDate DateTime? @db.Date
  notes                String?
  // false means closed; closing preserves the flock and its placement population.
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  farm         Farm         @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, farmId, id])
  @@unique([organizationId, code])
  @@index([organizationId, farmId, isActive])
  @@index([organizationId, farmId, placementDate])
  @@map("flocks")
}
