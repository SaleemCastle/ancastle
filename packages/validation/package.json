{
    "name": "@ancastle/validation",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@ancastle/types": "workspace:*",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "typescript": "^6.0.0",
        "vitest": "^5.0.5"
    }
}
